# ============================================================================
# QuantMind 环境变量模板 — 复制为 .env 后填入真实值
# ============================================================================

# ---------- LLM Providers ----------
# DeepSeek（推荐主力，便宜）：https://platform.deepseek.com
DEEPSEEK_API_KEY=
# 阿里通义千问（对标 Qwen Agent JD）：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=
# OpenAI（DPO 数据自动标注用 GPT-4 时需要）
OPENAI_API_KEY=
# Anthropic（可选 fallback）
ANTHROPIC_API_KEY=

# ---------- Local LLM (Ollama) ----------
# 本机 Ollama，开发期推荐用本地模型节省成本
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# ---------- Data Sources ----------
# Tushare：https://tushare.pro/register（免费 2000 积分，用于 f_ann_date 披露日）
TUSHARE_TOKEN=

# ---------- Paths ----------
DATA_ROOT=./data
CACHE_DIR=./.cache
LOG_DIR=./logs

# ---------- Runtime ----------
LOG_LEVEL=INFO
# 默认 provider：ollama | deepseek | qwen | openai | anthropic
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen2.5:7b

# ---------- Embedding ----------
# 推荐 BAAI/bge-m3（多语言+混合检索三合一，约 2GB 显存）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda

# ---------- Cost Guards ----------
MAX_TOKENS_PER_CALL=4096
MAX_DAILY_API_COST_CNY=20.0

# ---------- Database ----------
PG_HOST=localhost
PG_PORT=5432
PG_DB=quantmind
PG_USER=quantmind
PG_PASSWORD=CHANGE_ME
MONGO_URI=mongodb://localhost:27017
MONGO_DB=quantmind
# DATA_BACKEND: 'parquet'（生产，稳定，默认）/ 'postgres'（实验性）
# ⚠️ 实验性：当前 PG 多数表为空（仅 simulated_orders 有数据），
#    切到 postgres 后相关页面会显示空数据。需先运行
#    scripts/db_migration/02_import_pg.py 填充并校验后再启用。
DATA_BACKEND=parquet
# 'parquet_only'=只写 parquet（默认）,'dual'=双写,'db_only'=只写DB
WRITE_MODE=parquet_only
